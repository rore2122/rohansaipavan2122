diff --git a/app/globals.css b/app/globals.css
index 677c4b7..93a5ce9 100644
--- a/app/globals.css
+++ b/app/globals.css
@@ -4046,6 +4046,49 @@ body,
     backdrop-filter: blur(var(--glass-blur, 24px)) saturate(180%);
     -webkit-backdrop-filter: blur(var(--glass-blur, 24px)) saturate(180%);
   }
+
+  /* True lensing: bends the backdrop instead of just blurring it flat,
+     which is the part that actually reads as "liquid" rather than "frosted". */
+  @media (min-width: 640px) {
+    .liquid-glass {
+      backdrop-filter: blur(var(--glass-blur, 24px)) saturate(180%)
+        url(#lg-lens);
+      -webkit-backdrop-filter: blur(var(--glass-blur, 24px)) saturate(180%);
+    }
+  }
+}
+
+/* One extra crisp highlight ring along the top-left edge — this is the
+   "catching the light" cue real Liquid Glass has that flat glassmorphism lacks. */
+.liquid-glass::after {
+  content: "";
+  position: absolute;
+  inset: 0;
+  z-index: 0;
+  pointer-events: none;
+  border-radius: inherit;
+  padding: 1px;
+  background: linear-gradient(
+    140deg,
+    var(--glass-highlight) 0%,
+    transparent 22%,
+    transparent 78%,
+    var(--glass-shadow-inset) 100%
+  );
+  -webkit-mask:
+    linear-gradient(#000 0 0) content-box,
+    linear-gradient(#000 0 0);
+  -webkit-mask-composite: xor;
+  mask-composite: exclude;
+  opacity: var(--glass-edge-opacity, 0.55);
+}
+
+@media (prefers-reduced-transparency: reduce) {
+  .liquid-glass {
+    backdrop-filter: none !important;
+    -webkit-backdrop-filter: none !important;
+    background: var(--glass-fallback) !important;
+  }
 }
 
 @supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
@@ -7523,3 +7566,102 @@ html.lenis body {
     opacity: 0.4;
   }
 }
+
+/* =========================================================
+   LIQUID GLASS CONTROL (iOS 27 style Clear <-> Tinted slider)
+========================================================= */
+
+.lg-control-wrap {
+  position: fixed;
+  right: 24px;
+  bottom: 24px;
+  z-index: 60;
+  display: flex;
+  flex-direction: column;
+  align-items: flex-end;
+  gap: 10px;
+}
+
+.lg-control-toggle {
+  display: flex;
+  align-items: center;
+  gap: 8px;
+  padding: 10px 16px;
+  border-radius: 999px;
+  color: var(--text-primary);
+  font-family: "DM Mono", monospace;
+  font-size: 12px;
+  letter-spacing: 0.02em;
+  cursor: pointer;
+  transition: transform 220ms ease;
+}
+
+.lg-control-toggle:hover {
+  transform: translateY(-2px);
+}
+
+.lg-control-label {
+  white-space: nowrap;
+}
+
+.lg-control-panel {
+  width: 220px;
+  padding: 16px 18px 18px;
+  border-radius: 20px;
+}
+
+.lg-control-row {
+  display: flex;
+  justify-content: space-between;
+  font-family: "DM Mono", monospace;
+  font-size: 10px;
+  letter-spacing: 0.08em;
+  text-transform: uppercase;
+  color: var(--text-muted);
+  margin-bottom: 10px;
+}
+
+.lg-control-slider {
+  width: 100%;
+  appearance: none;
+  -webkit-appearance: none;
+  height: 4px;
+  border-radius: 999px;
+  background: linear-gradient(
+    90deg,
+    var(--glass-highlight),
+    var(--accent-bright)
+  );
+  outline: none;
+}
+
+.lg-control-slider::-webkit-slider-thumb {
+  -webkit-appearance: none;
+  width: 18px;
+  height: 18px;
+  border-radius: 50%;
+  background: var(--text-on-accent);
+  border: 1px solid var(--glass-border);
+  box-shadow: 0 2px 8px var(--shadow-medium);
+  cursor: pointer;
+}
+
+.lg-control-slider::-moz-range-thumb {
+  width: 18px;
+  height: 18px;
+  border-radius: 50%;
+  background: var(--text-on-accent);
+  border: 1px solid var(--glass-border);
+  box-shadow: 0 2px 8px var(--shadow-medium);
+  cursor: pointer;
+}
+
+@media (max-width: 640px) {
+  .lg-control-wrap {
+    right: 16px;
+    bottom: 16px;
+  }
+  .lg-control-panel {
+    width: 190px;
+  }
+}
